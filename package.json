{
  "private": true,
  "type": "commonjs",
  "scripts": {
    "format": "prettier --write . && eslint --fix .",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8"
  },
  "lint-staged": {
    "*.{html,css,json,md}": "prettier --write",
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
